---
// 站内搜索弹层：Pagefind UI 容器，首次打开才懒加载脚本（见 scripts/search.ts）
import { ui, type Locale } from '../data/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = ui(locale);
---
<div class="search-modal" id="search-modal" hidden>
  <div class="search-modal__backdrop" data-close-search></div>
  <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label={t.searchAria}>
    <div id="search" data-locale={locale}></div>
  </div>
</div>
