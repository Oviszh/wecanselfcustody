---
import { ui, type Locale } from '../data/ui';

interface Props {
  locale?: Locale;
  langHref?: string; // 语言切换目标（缺省为另一语言首页）
}
const { locale = 'en', langHref } = Astro.props;
const t = ui(locale);
const langTarget = langHref ?? (locale === 'en' ? '/zh' : '/');
const themeBtnId = 'theme-btn';
---

<header class="topbar">
  <button
    class="topbar__menu"
    id="menu-btn"
    type="button"
    title={t.menuToggle}
    aria-label={t.menuToggle}
    aria-expanded="false"
    aria-controls="nav"
  >
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="2.5" y1="5" x2="17.5" y2="5"></line>
        <line x1="2.5" y1="10" x2="17.5" y2="10"></line>
        <line x1="2.5" y1="15" x2="17.5" y2="15"></line>
      </g>
    </svg>
  </button>
  <div class="topbar__actions">
    <button class="topbar__search" id="search-btn" type="button" title={t.searchAria}>
      <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <line x1="13" y1="13" x2="17" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      </svg>
      <span>{t.search}</span>
    </button>
    <a
      class="topbar__lang"
      id="lang-btn"
      href={langTarget}
      title={locale === 'en' ? '切换到中文' : 'Switch to English'}
    >
      {t.langToggle}
    </a>
    <button class="topbar__btn" id={themeBtnId} type="button" title={t.themeToggle} aria-label={t.themeToggle}>
      <svg class="icon-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="10" y1="1.5" x2="10" y2="3.5"></line>
          <line x1="10" y1="16.5" x2="10" y2="18.5"></line>
          <line x1="1.5" y1="10" x2="3.5" y2="10"></line>
          <line x1="16.5" y1="10" x2="18.5" y2="10"></line>
          <line x1="4" y1="4" x2="5.4" y2="5.4"></line>
          <line x1="14.6" y1="14.6" x2="16" y2="16"></line>
          <line x1="16" y1="4" x2="14.6" y2="5.4"></line>
          <line x1="5.4" y1="14.6" x2="4" y2="16"></line>
        </g>
      </svg>
      <svg class="icon-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path
          d="M14.5 12.5A6.5 6.5 0 0 1 7.5 5.5a6.5 6.5 0 1 0 7 7z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
        ></path>
      </svg>
    </button>
  </div>
</header>
