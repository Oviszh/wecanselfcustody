---
import { getCollection, getEntry, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import PrevNext from '../../components/PrevNext.astro';
import Comments from '../../components/Comments.astro';
import { prevNext, routeFromId } from '../../data/nav';
import { ui } from '../../data/ui';

// 中文文章统一挂在 /zh 下：/zh/create-wallet、/zh/thinkings/about-hww …
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs
    .filter((e) => e.id !== 'home' && !e.data.draft)
    .map((entry) => ({
      params: { slug: routeFromId(entry.id) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const clean = routeFromId(entry.id);
const route = `zh/${clean}`; // 完整路由（含语言前缀），供 locale 推断 / canonical / body[data-route]
const isEmpty = !(entry.body ?? '').trim();
const pn = prevNext(route, 'zh');
const t = ui('zh');

// 语言切换：同页英文版存在时直连根路径，否则退回英文首页
const enCounterpart = await getEntry('docs-en', entry.id);
const langHref = enCounterpart ? '/' + clean : '/';
const altCanonical = enCounterpart ? new URL('/' + clean, Astro.site).href : undefined;
---
{
  isEmpty ? (
    <DocLayout title={entry.data.title} description={entry.data.description} route={route} langHref={langHref} altCanonical={altCanonical}>
      <div class="page-empty">
        <h1 class="page-title">{entry.data.title}</h1>
        <div class="page-placeholder">{t.contentComingSoon}</div>
      </div>
    </DocLayout>
  ) : (
    <DocLayout
      title={entry.data.title}
      description={entry.data.description}
      route={route}
      date={entry.data.date}
      updated={entry.data.updated}
      langHref={langHref}
      altCanonical={altCanonical}
    >
      <h1 class="page-title">{entry.data.title}</h1>
      <article class="md">
        <Content />
      </article>
      <PrevNext prev={pn.prev} next={pn.next} locale="zh" />
      <Comments locale="zh" title={entry.data.title} />
    </DocLayout>
  )
}
