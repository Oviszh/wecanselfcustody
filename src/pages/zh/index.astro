---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeNext from '../../components/HomeNext.astro';

// 中文首页（英文首页在 /）
const home = await getEntry('docs', 'home');
const { Content } = await render(home);
---
<BaseLayout isHome locale="zh" route="zh" langHref="/" altCanonical={new URL('/', Astro.site).href}>
  <script is:inline>
    // 旧 hash 链接迁移：#/for-humans/use-wallet/... -> /zh/use-wallet/...
    (function () {
      var m = location.hash.match(/^#\/(.*)$/);
      if (!m || !m[1]) return;
      var path = m[1].replace(/^for-humans\//, '');
      location.replace('/zh/' + path);
    })();
  </script>

  <header class="home-hero">
    <p class="home-hero__eyebrow">面向普通人</p>
    <h1 class="home-hero__title">让比特币自托管<br><span class="accent">简单又安全</span></h1>
  </header>

  <article class="md home-intro">
    <Content />
  </article>

  <HomeNext locale="zh" />
</BaseLayout>
